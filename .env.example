# ── MetaCoach environment template ──────────────────────
# Copy to `.env` and fill in. Local dev works with the defaults below.

# Database
#   Local (POC):  file:./dev.db
#   Production:   postgresql://user:pass@host:5432/metacoach?schema=public
DATABASE_URL="file:./dev.db"

# App
NEXT_PUBLIC_APP_NAME="MetaCoach"
APP_BASE_URL="http://localhost:3000"

# AI parsing of lab PDFs / InBody images
#   "mock"   → deterministic fake parser (no key, POC default)
#   "claude" → real Claude Vision parsing (requires ANTHROPIC_API_KEY)
PARSE_PROVIDER="mock"
ANTHROPIC_API_KEY=""
#   Parse model (optional): default claude-sonnet-5 (cost/capability sweet spot).
#   claude-haiku-4-5 = lowest cost · claude-opus-5 = maximum accuracy.
CLAUDE_PARSE_MODEL="claude-sonnet-5"

# Dynamic TDEE engine
TDEE_WINDOW_DAYS="21"

# Auth.js
AUTH_SECRET=""            # generate: openssl rand -base64 33
AUTH_TRUST_HOST="true"

# Web Push (PWA notifications) — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# ── Production-only (managed services) ───────────────────
# Database (managed Postgres): set DATABASE_URL above to a postgres:// URL.
#   The datasource provider auto-switches to postgresql (scripts/set-db-provider.mjs).
#   Apply schema with: npm run db:deploy   (runs prisma migrate deploy)

# Object storage (Cloudflare R2 or any S3-compatible bucket).
#   When these are set, uploaded lab/InBody files are stored here; otherwise ./storage (local disk).
# R2_ACCOUNT_ID=""                         # R2 only: builds the endpoint automatically
# S3_ENDPOINT=""                           # or set an explicit S3-compatible endpoint (MinIO/AWS)
# R2_BUCKET="metacoach-uploads"            # (or S3_BUCKET)
# R2_ACCESS_KEY_ID=""                      # (or S3_ACCESS_KEY_ID)
# R2_SECRET_ACCESS_KEY=""                  # (or S3_SECRET_ACCESS_KEY)
# S3_REGION="auto"                         # R2: "auto"; AWS: e.g. eu-central-1

# Error monitoring (Sentry). Fully inert until a DSN is provided.
# SENTRY_DSN=""                            # server/edge DSN
# NEXT_PUBLIC_SENTRY_DSN=""                # client DSN (browser)
# SENTRY_TRACES_SAMPLE_RATE="0.1"
# SENTRY_ORG=""                            # CI source-map upload (build-time)
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""                     # CI only — enables source-map upload

# Rate limiting / caching (optional, future)
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Wearable aggregator (deferred — Faz 3'te ertelendi)
# TERRA_API_KEY=""
# TERRA_DEV_ID=""
