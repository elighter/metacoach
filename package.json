{
  "name": "metacoach",
  "version": "0.1.0",
  "private": true,
  "description": "Next-Gen Adaptive Health & Nutrition platform — POC",
  "scripts": {
    "db:provider": "node scripts/set-db-provider.mjs",
    "predev": "npm run db:provider",
    "dev": "next dev",
    "prebuild": "npm run db:provider",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:push": "npm run db:provider && prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "npm run db:provider && prisma db push --force-reset --accept-data-loss && tsx prisma/seed.ts",
    "db:migrate": "npm run db:provider && prisma migrate dev",
    "db:deploy": "npm run db:provider && prisma migrate deploy",
    "setup": "npm run db:provider && prisma db push && tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@aws-sdk/client-s3": "^3.1108.0",
    "@aws-sdk/s3-request-presigner": "^3.1108.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@prisma/client": "6.2.1",
    "@sentry/nextjs": "^8.55.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/web-push": "^3.6.4",
    "bcryptjs": "^2.4.3",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "lucide-react": "0.469.0",
    "next": "^15.5.23",
    "next-auth": "^5.0.0-beta.25",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.0",
    "tailwind-merge": "2.6.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "20.17.12",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "autoprefixer": "10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.6",
    "postcss": "8.4.49",
    "prisma": "6.2.1",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
